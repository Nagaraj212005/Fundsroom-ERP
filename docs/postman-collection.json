{
  "info": {
    "name": "FundsRoom ERP API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        { "name": "Register Admin", "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/register", "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"System Administrator\",\n  \"email\": \"admin@fundsroom.com\",\n  \"password\": \"Admin@123\",\n  \"role\": \"ADMIN\"\n}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Login", "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@fundsroom.com\",\n  \"password\": \"Admin@123\"\n}", "options": { "raw": { "language": "json" } } } } }
      ]
    },
    {
      "name": "Case Study CRUD",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
      "item": [
        { "name": "Inventory", "request": { "method": "POST", "url": "{{baseUrl}}/api/inventory", "body": { "mode": "raw", "raw": "{\n  \"productId\": \"PRODUCT_ID\",\n  \"physicalQuantity\": 100,\n  \"reservedQuantity\": 20\n}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Enquiry", "request": { "method": "POST", "url": "{{baseUrl}}/api/enquiries", "body": { "mode": "raw", "raw": "{\n  \"enquiryNumber\": \"ENQ001\",\n  \"customerId\": \"CUSTOMER_ID\",\n  \"employeeId\": \"EMPLOYEE_ID\",\n  \"status\": \"NEW\"\n}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Quotation", "request": { "method": "POST", "url": "{{baseUrl}}/api/quotations", "body": { "mode": "raw", "raw": "{\n  \"quotationNumber\": \"QT001\",\n  \"customerId\": \"CUSTOMER_ID\",\n  \"employeeId\": \"EMPLOYEE_ID\",\n  \"discount\": 1000,\n  \"gst\": 18,\n  \"items\": [{\"productId\": \"PRODUCT_ID\", \"quantity\": 2, \"unitPrice\": 55000}]\n}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Sales Order", "request": { "method": "POST", "url": "{{baseUrl}}/api/sales-orders", "body": { "mode": "raw", "raw": "{\n  \"orderNumber\": \"SO001\",\n  \"quotationId\": \"QUOTATION_ID\"\n}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Reservation", "request": { "method": "POST", "url": "{{baseUrl}}/api/inventory-reservations", "body": { "mode": "raw", "raw": "{\n  \"salesOrderId\": \"ORDER_ID\",\n  \"inventoryId\": \"INVENTORY_ID\",\n  \"quantity\": 2\n}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Dispatch", "request": { "method": "POST", "url": "{{baseUrl}}/api/dispatches", "body": { "mode": "raw", "raw": "{\n  \"salesOrderId\": \"ORDER_ID\",\n  \"dispatchDate\": \"2026-09-17T10:00:00.000Z\"\n}", "options": { "raw": { "language": "json" } } } } }
      ]
    }
  ]
}
